{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "public/**", "scripts/**"],
  "rules": {
    "no-unused-vars": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  }
}
