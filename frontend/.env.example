# نمونهٔ متغیرهای محیطی فرانت‌اند (این فایل را به .env کپی کنید)
#
# نشانی API بک‌اند (شامل مسیر نسخه). در تولید این مقدار را به دامنهٔ واقعی
# تغییر دهید؛ همهٔ درخواست‌ها و آدرس تصاویر محصولات به‌صورت خودکار از همین
# مقدار ساخته می‌شوند.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# نشانی نهایی خود سایت (بدون اسلش انتهایی). برای canonical، og:url و ساخت
# sitemap.xml و robots.txt در زمان build لازم است. اگر خالی بماند، sitemap
# ساخته نمی‌شود و canonical بر پایهٔ دامنهٔ فعلی مرورگر نوشته می‌شود.
VITE_SITE_URL=https://example.com

# نشانی API بک‌اند (شامل مسیر نسخه).
# در تولید این مقدار را به دامنه واقعی تغییر دهید؛ همه درخواست‌ها و آدرس
# تصاویر محصولات به‌صورت خودکار از همین مقدار ساخته می‌شوند.
VITE_API_URL=http://127.0.0.1:8000/api/v1
